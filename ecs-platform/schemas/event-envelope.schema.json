{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.altayer.example/schemas/event-envelope.schema.json",
  "title": "ECS Event Envelope v1 — executable local profile",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "enum": [
        "ECS",
        "FYND",
        "SFCC",
        "ERP",
        "WMS",
        "FINANCE",
        "LOGISTICS"
      ]
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "market": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "idempotencyKey": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "entityType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$"
        }
      },
      "required": [
        "entityType",
        "entityId"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "additionalProperties": {}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {}
    }
  },
  "required": [
    "eventId",
    "type",
    "version",
    "occurredAt",
    "producer",
    "tenantId",
    "market",
    "correlationId",
    "subject",
    "data"
  ],
  "additionalProperties": false
}
