NODE_ENV=development
DATABASE_URL=postgresql://ecs:ecs_local_only@127.0.0.1:5432/ecs_demo
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MOCK_ORIGIN=http://127.0.0.1:4100
DEMO_MODE=true
FYND_MODE=mock
SFCC_MODE=mock
# Exact HTTPS hosts accepted for SFCC invoice references. ECS never fetches these URLs.
SFCC_INVOICE_ALLOWED_HOSTS=sfcc.demo.invalid
ERP_MODE=mock
WMS_MODE=mock
FINANCE_MODE=mock
LOGISTICS_MODE=mock
# Local-only fictional demo secrets. Replace before non-local use.
WEBHOOK_SECRET=ecs-local-webhook-secret-change-before-deployment
MOCK_SECRET=ecs-local-adapter-secret-change-before-deployment
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=ecs-documents
S3_ACCESS_KEY=ecs_local
S3_SECRET_KEY=ecs_local_storage_only
# Explicit local demo storage; use s3 for the supplied private MinIO bucket.
DOCUMENT_STORAGE=local
DOCUMENT_SCAN_MODE=mock
# Comma-separated exact HTTPS image hosts approved by the operator. Empty disables remote image fetching.
# demo://supplier/front.png uses only the configured loopback mock server, never an external supplier.
MEDIA_URL_ALLOWED_HOSTS=
