{
  "name": "ati-ecs-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,mocks,web 'tsx watch apps/api/src/main.ts' 'tsx watch apps/worker/src/main.ts' 'tsx watch apps/mock-systems/src/main.ts' 'next dev apps/web -H 127.0.0.1 -p 3000'",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:local": "concurrently -k -n api,worker,mocks,web 'tsx watch apps/api/src/main.ts' 'tsx watch apps/worker/src/local.ts' 'tsx watch apps/mock-systems/src/main.ts' 'next dev apps/web --webpack -H 127.0.0.1 -p 3000'",
    "dev:web": "next dev apps/web -H 127.0.0.1 -p 3000",
    "preview:local": "concurrently -k -n api,worker,mocks,web 'tsx apps/api/src/main.ts' 'tsx apps/worker/src/local.ts' 'tsx apps/mock-systems/src/main.ts' 'next start apps/web -H 127.0.0.1 -p 3000'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/reset.ts",
    "demo:history": "tsx scripts/historical-scenario.ts",
    "demo:documents": "tsx scripts/materialize-documents.ts",
    "demo:brand-rights": "tsx scripts/materialize-brand-rights.ts",
    "demo:reconciliation": "tsx scripts/reconciliation-scenario.ts",
    "fynd:check": "node --import tsx scripts/check-fynd-connection.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages prisma scripts tests",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "node --import tsx scripts/browser-acceptance.ts",
    "openapi:validate": "node --import tsx scripts/validate-openapi.ts",
    "requirements:validate": "node --import tsx scripts/validate-requirements.ts",
    "events:validate": "node --import tsx scripts/validate-events.ts",
    "build": "next build apps/web --webpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/client": "6.19.0",
    "bullmq": "^5.0.0",
    "csv-parse": "^6.0.0",
    "decimal.js": "^10.0.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "yauzl": "3.4.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "3.4.0",
    "concurrently": "^9.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.0.0",
    "openapi-types": "12.1.3",
    "prisma": "6.19.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
